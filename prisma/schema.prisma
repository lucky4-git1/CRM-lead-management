datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  SALES_MANAGER
  SALES_REP
  MARKETING
  SUPPORT
  READ_ONLY
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  NURTURING
  CONVERTED
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadSource {
  WEBSITE
  SOCIAL
  WHATSAPP
  SMS
  PHONE_CALL
  REFERRAL
  OUTBOUND
  OTHER
}

enum TaskType {
  CALL
  EMAIL
  WHATSAPP
  SMS
  MEETING
  FOLLOW_UP
  INTERNAL
  CUSTOM
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InteractionType {
  CALL
  EMAIL
  SMS
  WHATSAPP
  MEETING
  NOTE
  STATUS_CHANGE
  STAGE_CHANGE
  ASSIGNMENT
  AUTOMATION
  CONVERSION
}

enum InteractionDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum AssignmentStrategy {
  MANUAL
  ROUND_ROBIN
  LEAST_ACTIVE
  BY_TEAM
  BY_SOURCE
  BY_GEOGRAPHY
  BY_SCORE
}

enum TriggerType {
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_STATUS_CHANGED
  LEAD_ASSIGNED
  DEAL_STAGE_CHANGED
  DEAL_WON
  DEAL_LOST
  TASK_OVERDUE
  INCOMING_MESSAGE
  CALL_COMPLETED
}

enum IntegrationProvider {
  WHATSAPP
  TWILIO_SMS
  SENDGRID
  GENERIC_WEBHOOK
  TELEPHONY
  FACEBOOK_LEAD
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  timezone    String   @default("UTC")
  currency    String   @default("USD")
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships           Membership[]
  teams                 Team[]
  leads                 Lead[]
  contacts              Contact[]
  companies             Company[]
  pipelines             Pipeline[]
  deals                 Deal[]
  tasks                 Task[]
  interactions          Interaction[]
  assignmentRules       LeadAssignmentRule[]
  automationRules       AutomationRule[]
  automationLogs        AutomationExecutionLog[]
  scoringRules          LeadScoringRule[]
  captureForms          LeadCaptureForm[]
  integrationAccounts   IntegrationAccount[]
  auditLogs             AuditLog[]
  importJobs            ImportJob[]
  savedViews            SavedView[]

  @@index([slug])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships       Membership[]
  ownedLeads        Lead[]               @relation("LeadOwner")
  createdLeads      Lead[]               @relation("LeadCreator")
  updatedLeads      Lead[]               @relation("LeadUpdater")
  assignedTasks     Task[]               @relation("TaskAssignee")
  createdTasks      Task[]               @relation("TaskCreator")
  performedActions  Interaction[]        @relation("InteractionActor")
  ownedDeals        Deal[]               @relation("DealOwner")
  ownedContacts     Contact[]            @relation("ContactOwner")
  ownedCompanies    Company[]            @relation("CompanyOwner")
  auditLogs         AuditLog[]
  importJobs        ImportJob[]
  savedViews        SavedView[]
  ledTeams          Team[]               @relation("TeamLeader")
  teamMemberships   TeamMember[]

  @@index([email])
}

model Membership {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           Role         @default(SALES_REP)
  teamId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Team {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  leaderId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leader         User?        @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  memberships    Membership[]
  teamMembers    TeamMember[]
  leads          Lead[]

  @@index([organizationId])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Lead {
  id                      String        @id @default(uuid())
  organizationId          String
  firstName               String
  lastName                String
  email                   String?
  phone                   String?
  whatsapp                String?
  companyName             String?
  jobTitle                String?
  website                 String?
  industry                String?
  address                 String?
  city                    String?
  state                   String?
  country                 String?
  postalCode              String?
  source                  LeadSource    @default(WEBSITE)
  sourceCampaign          String?
  sourceChannel           String?
  externalSourceId        String?
  ownerId                 String?
  teamId                  String?
  status                  LeadStatus    @default(NEW)
  qualificationScore      Int           @default(0)
  priority                LeadPriority  @default(MEDIUM)
  interestedProduct       String?
  estimatedValue          Float         @default(0.0)
  currency                String        @default("USD")
  expectedPurchaseDate    DateTime?
  tags                    String[]      @default([])
  notes                   String?       @db.Text
  customFields            Json          @default("{}")
  consentGiven            Boolean       @default(false)
  consentTimestamp        DateTime?
  communicationPreferences Json         @default("{\"email\": true, \"sms\": true, \"whatsapp\": true}")
  isArchived              Boolean       @default(false)
  convertedAt             DateTime?
  convertedContactId      String?
  convertedCompanyId      String?
  convertedDealId         String?
  createdById             String?
  updatedById             String?
  lastContactAt           DateTime?
  nextFollowUpAt          DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  organization            Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner                   User?         @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  team                    Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy               User?         @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy               User?         @relation("LeadUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  tasks                   Task[]
  interactions            Interaction[]
  scoringLogs             LeadScoringLog[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, createdAt])
}

model Contact {
  id                   String        @id @default(uuid())
  organizationId       String
  companyId            String?
  firstName            String
  lastName             String
  email                String?
  phone                String?
  mobile               String?
  jobTitle             String?
  department           String?
  isPrimary            Boolean       @default(false)
  lifecycleStage       String        @default("LEAD")
  tags                 String[]      @default([])
  customFields         Json          @default("{}")
  address              String?
  city                 String?
  state                String?
  country              String?
  ownerId              String?
  convertedFromLeadId  String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company              Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner                User?         @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deals                Deal[]
  tasks                Task[]
  interactions         Interaction[]

  @@index([organizationId])
  @@index([organizationId, email])
  @@index([companyId])
}

model Company {
  id                    String        @id @default(uuid())
  organizationId        String
  name                  String
  domain                String?
  industry              String?
  size                  String?
  website               String?
  phone                 String?
  address               String?
  city                  String?
  state                 String?
  country               String?
  annualRevenue         Float?
  totalOpportunityValue Float         @default(0.0)
  ownerId               String?
  tags                  String[]      @default([])
  customFields          Json          @default("{}")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner                 User?         @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts              Contact[]
  deals                 Deal[]
  tasks                 Task[]
  interactions          Interaction[]

  @@index([organizationId])
  @@index([organizationId, name])
}

model Pipeline {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages         PipelineStage[]
  deals          Deal[]

  @@index([organizationId])
}

model PipelineStage {
  id             String    @id @default(uuid())
  pipelineId     String
  name           String
  stageOrder     Int
  winProbability Int       @default(10)
  color          String    @default("#3b82f6")
  isWon          Boolean   @default(false)
  isLost         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  pipeline       Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals          Deal[]

  @@index([pipelineId])
  @@index([pipelineId, stageOrder])
}

model Deal {
  id                String        @id @default(uuid())
  organizationId    String
  pipelineId        String
  stageId           String
  title             String
  amount            Float         @default(0.0)
  currency          String        @default("USD")
  probability       Int           @default(20)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  ownerId           String?
  contactId         String?
  companyId         String?
  leadId            String?
  status            DealStatus    @default(OPEN)
  lostReason        String?
  customFields      Json          @default("{}")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline          Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage             PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner             User?         @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contact           Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  tasks             Task[]
  interactions      Interaction[]

  @@index([organizationId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([organizationId, status])
}

model Task {
  id             String        @id @default(uuid())
  organizationId String
  title          String
  description    String?       @db.Text
  taskType       TaskType      @default(FOLLOW_UP)
  priority       TaskPriority  @default(MEDIUM)
  status         TaskStatus    @default(PENDING)
  dueDate        DateTime
  dueTime        String?
  completedAt    DateTime?
  outcome        String?
  assignedToId   String?
  createdById    String?
  leadId         String?
  contactId      String?
  dealId         String?
  companyId      String?
  isReminderSent Boolean       @default(false)
  reminderAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo     User?         @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy      User?         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal           Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, assignedToId])
  @@index([organizationId, dueDate])
}

model Interaction {
  id              String               @id @default(uuid())
  organizationId  String
  type            InteractionType
  direction       InteractionDirection @default(INTERNAL)
  summary         String
  body            String?              @db.Text
  outcome         String?
  durationSeconds Int?
  metadata        Json                 @default("{}")
  actorId         String?
  leadId          String?
  contactId       String?
  dealId          String?
  companyId       String?
  createdAt       DateTime             @default(now())

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor           User?                @relation("InteractionActor", fields: [actorId], references: [id], onDelete: SetNull)
  lead            Lead?                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact         Contact?             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal            Deal?                @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company         Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@index([contactId])
  @@index([dealId])
  @@index([createdAt])
}

model LeadAssignmentRule {
  id                 String             @id @default(uuid())
  organizationId     String
  name               String
  priority           Int                @default(1)
  isActive           Boolean            @default(true)
  strategy           AssignmentStrategy @default(ROUND_ROBIN)
  conditions         Json               @default("{}")
  assignToTeamId     String?
  assignToUserId     String?
  roundRobinUserIds  String[]           @default([])
  lastAssignedUserId String?
  fallbackUserId     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, priority])
}

model AutomationRule {
  id              String                   @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  isActive        Boolean                  @default(true)
  triggerType     TriggerType
  conditions      Json                     @default("[]")
  actions         Json                     @default("[]")
  executionCount  Int                      @default(0)
  lastExecutedAt  DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logs            AutomationExecutionLog[]

  @@index([organizationId])
  @@index([organizationId, triggerType])
}

model AutomationExecutionLog {
  id             String         @id @default(uuid())
  organizationId String
  ruleId         String
  triggerType    TriggerType
  entityType     String
  entityId       String
  status         String         @default("SUCCESS")
  details        Json           @default("{}")
  executedAt     DateTime       @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule           AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([ruleId])
}

model LeadScoringRule {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  isActive       Boolean      @default(true)
  criteriaType   String
  condition      String
  value          String
  scoreDelta     Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model LeadScoringLog {
  id          String   @id @default(uuid())
  leadId      String
  ruleId      String?
  scoreBefore Int
  scoreAfter  Int
  reason      String
  createdAt   DateTime @default(now())

  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadCaptureForm {
  id                 String       @id @default(uuid())
  organizationId     String
  name               String
  publicFormKey      String       @unique
  isActive           Boolean      @default(true)
  allowedOrigins     String?
  submitButtonText   String       @default("Submit")
  successMessage     String       @default("Thank you! We will get in touch soon.")
  redirectUrl        String?
  fieldConfig        Json         @default("[]")
  defaultLeadSource  LeadSource   @default(WEBSITE)
  defaultCampaign    String?
  defaultOwnerId     String?
  submissionsCount   Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([publicFormKey])
}

model IntegrationAccount {
  id             String              @id @default(uuid())
  organizationId String
  provider       IntegrationProvider
  name           String
  isActive       Boolean             @default(true)
  credentials    Json                @default("{}")
  settings       Json                @default("{}")
  status         String              @default("CONNECTED")
  lastSyncAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, provider])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String
  oldData        Json?
  newData        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
}

model ImportJob {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  entityType     String       @default("LEAD")
  fileName       String
  totalRows      Int          @default(0)
  processedRows  Int          @default(0)
  successRows    Int          @default(0)
  errorRows      Int          @default(0)
  status         String       @default("COMPLETED")
  errors         Json         @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model SavedView {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  name           String
  entityType     String
  filters        Json         @default("{}")
  columns        Json         @default("[]")
  sort           Json         @default("{}")
  isDefault      Boolean      @default(false)
  isShared       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, entityType])
}
